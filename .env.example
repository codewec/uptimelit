# Optional authentication settings read by Docker Compose.
# To enable OIDC, set issuer, client ID, client secret and the exact callback URL.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_BUTTON_TITLE=Sign in with OIDC
DISABLE_PASSWORD_LOGIN=false
OIDC_INSECURE_SKIP_TLS_VERIFY=false
# Optional, at least 32 bytes. Otherwise a key is generated and stored in SQLite.
JWT_SECRET=
